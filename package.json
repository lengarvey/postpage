{
  "name": "postpage-server",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "bin": {
    "postpage": "./cli/dist/main.js"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy:prod": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply postpage --local"
  },
  "dependencies": {
    "@workos-inc/node": "^10.14.0",
    "hono": "^4.13.13",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^7.0.2",
    "vitest": "~4.1.12",
    "wrangler": "^4.152.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
